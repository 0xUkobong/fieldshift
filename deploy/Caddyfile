www.fieldshift.cloud {
	redir https://fieldshift.cloud{uri} permanent
}

fieldshift.cloud {
	encode zstd gzip
	redir /explorer /explorer/ 308

	@crawler_files path /robots.txt /sitemap.xml /llms.txt
	handle @crawler_files {
		root * /srv/fieldshift/static
		file_server
	}

	handle_path /assets/* {
		root * /srv/fieldshift/static
		file_server
	}

	@root_icons path /favicon.ico /favicon.png /favicon-32.png /apple-touch-icon.png /icon-512.png /site.webmanifest /logo.png /og.png
	handle @root_icons {
		root * /srv/fieldshift/static
		file_server
	}

	@explorer path /explorer /explorer/*
	handle @explorer {
		reverse_proxy 127.0.0.1:8501
	}

	handle {
		root * /srv/fieldshift/public
		try_files {path} /index.html
		file_server
	}
}
